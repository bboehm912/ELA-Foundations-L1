<!-- INLINE LIGHTWEIGHT SCRIPT (Navigation & Bellringer Randomizer) -->
<script>
  // Bellringer Randomizer Array
  const bellringers = [
    "What is the single most important strategy you use when encountering a word you do not recognize in a reading?",
    "In your own words, why is 'academic integrity' critical when citing evidence from source texts?",
    "How does identifying root words help you decode unfamiliar vocabulary across different school subjects?",
    "Why is evaluating an author's word choice (diction) essential before making a formal academic claim?",
    "How does breaking a word into prefixes and suffixes change your understanding of its core meaning?"
  ];

  function randomizeBellringer() {
    const idx = Math.floor(Math.random() * bellringers.length);
    document.getElementById('bellringer-display').innerText = '"' + bellringers[idx] + '"';
  }

  // Slide Navigation Logic
  let currentSlide = 1;
  const totalSlides = 12;

  function moveSlide(dir) {
    const newSlide = currentSlide + dir;
    if (newSlide >= 1 && newSlide <= totalSlides) {
      document.getElementById('slide-' + currentSlide).classList.remove('active');
      currentSlide = newSlide;
      document.getElementById('slide-' + currentSlide).classList.add('active');
      
      document.getElementById('slide-tracker').innerText = `Slide ${currentSlide} of ${totalSlides}`;
      document.getElementById('prev-btn').disabled = (currentSlide === 1);
      document.getElementById('next-btn').disabled = (currentSlide === totalSlides);
    }
  }

  // Tab Switching Logic
  function switchTab(tabKey) {
    document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
    document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));

    if (tabKey === 'deck') {
      document.querySelectorAll('.tab-btn')[0].classList.add('active');
      document.getElementById('deck-tab').classList.add('active');
    } else if (tabKey === 'res') {
      document.querySelectorAll('.tab-btn')[1].classList.add('active');
      document.getElementById('res-tab').classList.add('active');
    } else if (tabKey === 'form') {
      document.querySelectorAll('.tab-btn')[2].classList.add('active');
      document.getElementById('form-tab').classList.add('active');
    }
  }

  // Initialize on load
  window.addEventListener('DOMContentLoaded', () => {
    randomizeBellringer();
  });
</script>

